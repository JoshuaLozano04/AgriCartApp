# Backend API Configuration
# Update this with your backend server URL
API_BASE_URL=http://localhost:8000/api

# Image Service
# Update this with your image service URL (usually same as API base + /images)
IMAGE_SERVICE_URL=http://localhost:8000/api/images

# Firebase Configuration
# Note: Firebase is configured via firebase_options.dart
# No additional configuration needed here for basic setup

# Optional: Add any other environment variables you need
# EXAMPLE_API_KEY=your-api-key-here
