# ===========================================
# AgriCart Backend - Render Production Environment Variables
# ===========================================
# Copy these to your Render Web Service environment variables
# Replace placeholder values with your actual credentials

# Django Configuration
# Generate a secure secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-secret-key-here

# Set to False in production
DEBUG=False

# Your Render app domain (e.g., agricart-backend.onrender.com)
ALLOWED_HOSTS=your-app.onrender.com

# Your Flutter app URL (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=https://your-flutter-app.com

# MongoDB Atlas Configuration
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_CONNECTION_STRING=mongodb+srv://admin:root@cluster0.jwfcyuo.mongodb.net/
MONGODB_DATABASE_NAME=agricart_db

# Upstash Redis Configuration (for Django Channels WebSocket)
# Format: rediss://default:TOKEN@HOSTNAME:6379
# Convert from: https://fun-hedgehog-24996.upstash.io
REDIS_URL=rediss://default:AWGkAAIncDI4MTdmZWFmNDc5MWY0ZWRjYjgwNmJhOTc1M2ZjMmFhZnAyMjQ5OTY@fun-hedgehog-24996.upstash.io:6379
REDIS_TOKEN=AWGkAAIncDI4MTdmZWFmNDc5MWY0ZWRjYjgwNmJhOTc1M2ZjMmFhZnAyMjQ5OTY

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=agricart-11da1
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=agricart-11da1.firebasestorage.app

# PayMongo Payment Gateway
# Get from: https://dashboard.paymongo.com/developers
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here

# Security Settings (for HTTPS)
CSRF_COOKIE_SECURE=True

# Image Service URL (your deployed backend URL)
IMAGE_SERVICE_URL=https://your-app.onrender.com/api/images

# ===========================================
# DEPLOYMENT CHECKLIST
# ===========================================
# 
# 1. MongoDB Atlas Setup:
#    - Log in to MongoDB Atlas
#    - Go to Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
#    - Verify database name is 'agricart_db' or update MONGODB_DATABASE_NAME
#
# 2. Upstash Redis Setup:
#    - Already configured with provided credentials
#    - Verify connection at: https://console.upstash.com/
#
# 3. Firebase Setup:
#    - Upload serviceAccountKey.json as Render Secret File
#    - Name it: serviceAccountKey.json
#    - Path will be: /etc/secrets/serviceAccountKey.json
#
# 4. Render Web Service Setup:
#    - Go to: https://dashboard.render.com/
#    - Create New → Web Service
#    - Connect your GitHub repository (JoshuaLozano04/AgriCartApp)
#    - Root Directory: Backend
#    - Environment: Python 3
#    - Build Command: chmod +x build.sh && ./build.sh
#    - Start Command: daphne -b 0.0.0.0 -p $PORT agricart_api.asgi:application
#    - Add all environment variables from this file
#
# 5. Add Secret Files in Render:
#    - Go to your Web Service → Environment
#    - Scroll to "Secret Files"
#    - Add File: serviceAccountKey.json
#    - Paste contents from Backend/serviceAccountKey.json
#
# 6. Testing:
#    - API Health: https://your-app.onrender.com/api/
#    - WebSocket: wss://your-app.onrender.com/ws/chat/<conversation_id>/
#
# ===========================================
# IMPORTANT NOTES
# ===========================================
#
# - Render Free Tier: App spins down after 15 min of inactivity
# - First request after spin-down takes 50+ seconds
# - Media files (product images) won't persist on Render's ephemeral storage
# - Consider migrating to Cloudinary/AWS S3 for production image storage
# - WebSocket connections require persistent Redis (Upstash Redis is persistent)
#
